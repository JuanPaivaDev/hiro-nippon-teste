# Required for the server adapter to call the existing n8n workflows.
HIRO_CHANNEL_KEY=

# Supabase publishable key used by the existing demo.
HIRO_CLUB_PUBLISHABLE_KEY=

# Optional phone verification. Keep these unset if that service is not configured.
HIRO_PHONE_KEY=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_API_KEY=
TWILIO_VERIFY_API_SECRET=
